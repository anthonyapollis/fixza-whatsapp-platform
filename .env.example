# --- Meta WhatsApp Cloud API (from developers.facebook.com > your app) ---
WHATSAPP_TOKEN=            # System-user or temporary access token
WHATSAPP_PHONE_NUMBER_ID=  # Phone number ID (not the phone number itself)
WHATSAPP_VERIFY_TOKEN=fixza-verify-token   # Any string; must match webhook config in Meta dashboard
META_APP_SECRET=           # App secret, used to verify X-Hub-Signature-256 on incoming webhooks

# --- Database ---
# Local dev default is SQLite (no setup needed). For Supabase use the connection
# string from Project Settings > Database, e.g.:
# DATABASE_URL=postgresql+psycopg2://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./fixza.db

# --- Optional: Claude-powered job classification (falls back to keyword rules) ---
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
